# --- MQTT ---
MQTT_URL=mqtt://localhost:1883
MQTT_TOPIC_PREFIX=feeder
MQTT_CLIENT_ID=feeder-dashboard

# Broker dijalankan DI DALAM aplikasi (tidak perlu install mosquitto).
# Set false kalau mau memakai broker eksternal sesuai MQTT_URL di atas.
EMBED_BROKER=true
BROKER_BIND=0.0.0.0:1883

# --- Database ---
# SQLite, berjalan di dalam proses aplikasi. Kosongkan untuk memakai
# dashboard/feeder.db (default).
# DB_PATH=./feeder.db

# --- Perintah ---
# Perintah tanpa ack > 30 detik -> timeout
COMMAND_TIMEOUT_SEC=30
SWEEP_INTERVAL_MS=10000

# --- UI ---
# Jumlah pesan MQTT terakhir yang ditampilkan di tab Live
LIVE_TAIL_SIZE=200
