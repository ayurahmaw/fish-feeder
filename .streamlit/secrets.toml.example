# Copy the contents into Streamlit Community Cloud -> App settings -> Secrets.
# On Cloud there is no .env file; these values are injected as environment
# variables by dashboard/config.py, so the keys match .env exactly.

# --- MQTT ---
# Default: embed the broker inside the app (works, but no external device can
# reach it from the internet — good enough to browse the seeded dashboard).
EMBED_BROKER = "true"

# To let sim.js / the ESP32 publish from elsewhere, point the app at a broker
# they can reach and disable the embedded one. Example with a public broker:
# EMBED_BROKER = "false"
# MQTT_URL = "mqtt://broker.hivemq.com:1883"
# MQTT_TOPIC_PREFIX = "feeder-ayurahmaw"

# MQTT_URL = "mqtt://localhost:1883"
MQTT_TOPIC_PREFIX = "feeder-ayurahmaw"
MQTT_CLIENT_ID = "feeder-dashboard"

# Optional: authenticated + TLS broker (e.g. HiveMQ Cloud free).
# Leave blank for anonymous brokers.
# MQTT_URL = "mqtts://your-cluster.s1.eu.hivemq.cloud:8883"
# MQTT_USERNAME = "your-username"
# MQTT_PASSWORD = "your-password"
# MQTT_TLS = "true"

# --- Database ---
# Cloud storage is ephemeral: feeder.db is recreated (and reseeded) on restart.
# Download/upload a backup from the dashboard sidebar to carry history across
# redeploys.
# DB_PATH = "./feeder.db"

# --- Commands / UI ---
# COMMAND_TIMEOUT_SEC = "30"
# SWEEP_INTERVAL_MS = "10000"
# LIVE_TAIL_SIZE = "200"
