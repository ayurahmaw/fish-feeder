%% title: Streamlit session, sidebar order and page selection
%% source: dashboard/app.py:37-166 guard, sidebar, topbar, routing
%% source: dashboard/data.py:26-64 cache TTL 2 s, actions.py:15-24 client_command
%% note: st.navigation renders exactly one page per rerun, in a single script thread.

flowchart TD
  G["entry: get_runtime, then data.devices"]
  STOP["st.error no device, st.stop"]

  subgraph SHELL["sidebar and topbar, rendered top to bottom"]
    direction TB
    SB1["device selectbox"]
    SB2["system health, ID or EN toggle, data backup"]
    SB3["topbar: page title, online badge, refresh"]
    SB1 --> SB2 --> SB3
  end

  SEL{"page selected in the sidebar<br/>exactly one per rerun"}
  P1["Status page"]
  P2["Live page"]
  P3["Alerts page"]
  P4["History page"]
  P5["Schedules page"]
  P6["Control page"]
  A1["mark one or all as read"]
  A2["add, edit, delete, toggle, send to device"]
  A3["manual feed, servo test, threshold, RTC, get_state"]
  RD["read path: data.py st.cache_data TTL 2 s"]
  WR["write path: actions.client_command"]
  DB[("SQLite feeder.db")]
  MQ["MQTT publish command QoS 1"]

  G -->|"list empty"| STOP
  G -->|"rows found"| SB1
  SB3 --> SEL
  SEL -->|"Status"| P1
  SEL -->|"Live"| P2
  SEL -->|"Alerts"| P3
  SEL -->|"History"| P4
  SEL -->|"Schedules"| P5
  SEL -->|"Control"| P6
  P1 --> RD
  P2 --> RD
  P3 --> A1
  A1 --> DB
  P4 --> RD
  P5 --> A2
  P6 --> A3
  A2 --> WR
  A3 --> WR
  RD -->|"SELECT"| DB
  WR -->|"BEGIN IMMEDIATE then INSERT"| DB
  WR -->|"after commit"| MQ
