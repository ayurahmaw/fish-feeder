%% title: Firmware setup and cooperative main loop
%% source: firmware/esp32_feeder/esp32_feeder.ino:429-470 setup and loop
%% source: firmware/esp32_feeder/config.h:84-87 tick intervals

flowchart TD
  subgraph SETUP["setup()"]
    direction TB
    S1["Serial 115200, 300 ms pause"]
    S2["hw::begin<br/>I2C scan, servo closed, RTC, LCD"]
    S3["proto::begin<br/>NVS threshold, fireDate, mask, schedules"]
    S4["net::begin<br/>WiFi STA, id from MAC, buffer 1024, keepalive 60"]
    S5["splash 3000 ms, measure distance"]
    S1 --> S2 --> S3 --> S4 --> S5
  end

  subgraph LOOP["loop(), no delay, everything millis driven"]
    direction TB
    T1["net::tick<br/>retry every 5000 ms"]
    E1{"rising edge<br/>MQTT connected?"}
    A1["publishTelemetry at once"]
    E2{"rising edge<br/>WiFi connected?"}
    A2["ntpStart<br/>pool.ntp.org, UTC+7"]
    T1 --> E1
    E1 -->|"yes"| A1
    E1 -->|"no"| E2
    A1 --> E2
    E2 -->|"yes"| A2
  end

  D["tick functions<br/>called in turn, once per iteration"]
  C1["commandTick<br/>one command, queue 4"]
  C2["ntpTick<br/>epoch 1600000000"]
  C3["feedTick<br/>gate phases"]
  C4["sensorTick<br/>2000 ms"]
  C5["scheduleTick<br/>1000 ms"]
  C6["telemetryTick<br/>15000 ms"]
  C7["displayTick<br/>500 ms"]

  S5 --> T1
  E2 -->|"no"| D
  A2 --> D
  D --> C1
  D --> C2
  D --> C3
  D --> C4
  D --> C5
  D --> C6
  D --> C7
  C7 -->|"next iteration"| T1
